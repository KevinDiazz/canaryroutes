# CanaryRoutes — Variables de entorno
# Copia este archivo como .env.local (dev) o configura en Cloudflare Pages (prod)

# URL del sitio (sin trailing slash)
# Producción: https://canaryroutes.com
NEXT_PUBLIC_SITE_URL=https://canaryroutes.com

# Google Analytics 4
# Obtén el Measurement ID en: https://analytics.google.com
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console
# Obtén el código en: https://search.google.com/search-console
# Elige verificación "Etiqueta HTML" → copia solo el valor del atributo content
NEXT_PUBLIC_GSC_VERIFICATION=
